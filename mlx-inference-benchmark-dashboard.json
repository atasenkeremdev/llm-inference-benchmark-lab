        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      }
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Prefill share of measured total time",
      "description": "Calculated prefill seconds divided by measured total latency. An approximation, not a separately instrumented phase timer.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * mlx_prefill_duration_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"} / on (job,instance,model,prompt_tokens,generation_tokens) mlx_total_latency_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "legendFormat": "{{prompt_tokens}} input / {{generation_tokens}} output",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      }
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "Decode share of measured total time",
      "description": "Calculated decode seconds divided by measured total latency. Shares may not sum to exactly 100% because of runtime overhead and independent averages.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * mlx_decode_duration_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"} / on (job,instance,model,prompt_tokens,generation_tokens) mlx_total_latency_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "legendFormat": "{{prompt_tokens}} input / {{generation_tokens}} output",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest benchmark values by configuration",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mlx_prefill_tokens_per_second{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "mlx_generation_tokens_per_second{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "mlx_peak_memory_gb{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "mlx_total_latency_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "prompt_tokens",
            "mode": "outer"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
