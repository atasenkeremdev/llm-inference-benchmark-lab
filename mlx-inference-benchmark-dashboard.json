      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Measured total benchmark latency",
      "description": "Mean total_time from the actual benchmark trials, including overhead.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mlx_total_latency_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "legendFormat": "{{prompt_tokens}} input / {{generation_tokens}} output",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Estimated TTFT — not measured",
      "description": "Approximation: prefill duration + one average decode token. Real TTFT needs streamed first-token timing.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mlx_estimated_ttft_seconds{job=\"mlx-mac-mini\",model=~\"$model\",generation_tokens=~\"$generation_tokens\"}",
          "legendFormat": "{{prompt_tokens}} input / {{generation_tokens}} output",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
